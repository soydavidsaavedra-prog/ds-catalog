# Copy to .env.local and fill in real values before deploying.
# See README.md for details on each variable.

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SUPERADMIN_SESSION_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=

# Supabase (run supabase/schema.sql once, then `npm run seed:supabase`)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Error logging (Sentry) — all optional; leave unset to keep it fully inactive
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Dominio propio por tenant (Vercel Domains API) — all optional; without
# these, a tenant can still save a domain but it stays in manual-DNS mode
# (see README.md's "Dominio propio por tenant" section)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
