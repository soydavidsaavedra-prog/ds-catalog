# Copy to .env.local and fill in real values before deploying.
# See README.md for details on each variable.

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SUPERADMIN_SESSION_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=

# Supabase (run supabase/schema.sql once, then `npm run seed:supabase`)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Error logging (Sentry) — all optional; leave unset to keep it fully inactive
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Dominio propio por tenant (Vercel Domains API) — all optional; without
# these, a tenant can still save a domain but it stays in manual-DNS mode
# (see README.md's "Dominio propio por tenant" section)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Notificaciones por correo (Resend) — all optional; without these, the
# app just logs instead of emailing (see README.md's "Notificaciones" section)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Automatización de redes sociales (/admin/redes-sociales) — all optional;
# without these, "Conectar cuenta" shows a clear "no configurado" message
# instead of failing. See docs/ARCHITECTURE.md's "Redes sociales" section
# for how to obtain each one and their real-world limitations (App Review,
# token expiry, TikTok's draft-only unaudited posting).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Shared secret Vercel Cron sends back as `Authorization: Bearer <value>`
# when it calls /api/cron/social-publish — without it, that endpoint
# refuses every request rather than running unauthenticated.
CRON_SECRET=

# Asistente de IA para productos (Claude) — optional; without this, the
# "Sugerir con IA" button simply doesn't appear on the product form
ANTHROPIC_API_KEY=
